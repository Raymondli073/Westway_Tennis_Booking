/* 首页样式 */
.page {
  padding: 0 0 60rpx;
}

/* Hero */
.hero {
  background: linear-gradient(135deg, #006633 0%, #009950 100%);
  padding: 70rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.hero-icon  { font-size: 80rpx; margin-bottom: 20rpx; }
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,.8);
  line-height: 1.6;
}

/* Card */
.card {
  background: #fff;
  margin: 32rpx 28rpx 0;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,.08);
}
.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #006633;
  display: block;
  margin-bottom: 16rpx;
}
.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  display: block;
  margin-bottom: 36rpx;
}

/* Input */
.input-wrap {
  display: flex;
  align-items: center;
  background: #f5f9f6;
  border: 2rpx solid #cde6d8;
  border-radius: 14rpx;
  padding: 0 24rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  transition: border-color .2s;
}
.input-wrap.focused { border-color: #006633; background: #fff; }
.input-icon { font-size: 34rpx; margin-right: 16rpx; }
.email-input {
  flex: 1;
  font-size: 30rpx;
  color: #222;
  height: 96rpx;
}
.placeholder { color: #bbb; }

/* Subscribe button */
.btn-subscribe {
  width: 100%;
  height: 96rpx;
  background: #006633;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.btn-subscribe.loading { background: #4caf7d; }
.btn-subscribe[disabled] { opacity: .7; }

.hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
}

/* Feature grid */
.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 28rpx 28rpx 0;
}
.feature-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.feature-icon  { font-size: 52rpx; margin-bottom: 14rpx; }
.feature-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #006633;
  margin-bottom: 8rpx;
  display: block;
}
.feature-desc {
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
  display: block;
}

/* Stat */
.stat-bar {
  text-align: center;
  margin-top: 32rpx;
  padding: 20rpx;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #006633;
}
.stat-label {
  font-size: 26rpx;
  color: #888;
}
