# ── EveryoneActive login (your Westway account) ──────────────────────────────
EA_EMAIL=your_everyoneactive_email@example.com
EA_PASSWORD=your_everyoneactive_password

# ── Email notification recipient ──────────────────────────────────────────────
NOTIFY_EMAIL=Raymondli073@gmail.com

# ── Gmail SMTP sender (use an App Password, NOT your normal Gmail password) ──
# To create an App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # 16-char Google App Password

# ── Optional settings ─────────────────────────────────────────────────────────
DAYS_AHEAD=7          # how many days ahead to check
HEADLESS=true         # set to false to watch the browser while scraping
